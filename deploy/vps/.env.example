# Copiez ce modèle en .env sur le VPS et remplacez les valeurs d’exemple.
# Générez les mots de passe et la clé secrète directement sur le VPS.

# Image de repli pour une opération manuelle; le workflow remplace cette valeur au déploiement.
FLOWSTOCK_IMAGE=ghcr.io/OWNER/REPOSITORY-api:v1.0.0
FLOWSTOCK_API_PORT=8000

POSTGRES_DB=flowstock
POSTGRES_USER=flowstock
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_HEXADECIMAL

DJANGO_SECRET_KEY=REMPLACER_PAR_UNE_CLE_SECRETE_ALEATOIRE
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost
ACTIVER_DOCUMENTATION_API=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
