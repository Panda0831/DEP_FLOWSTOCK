DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Développement : SQLite local. Production : renseignez DATABASE_URL avec PostgreSQL.
SQLITE_NAME=db.sqlite3
DATABASE_URL=
# Si le client web est servi sur un autre domaine, utilisez des origines HTTPS exactes.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SAMESITE=Lax
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
PASSWORD_RESET_TIMEOUT=3600
