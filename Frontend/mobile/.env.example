# URL du backend, jusqu’au préfixe /api/v1 inclus.
# USB Android : exécuter `adb reverse tcp:8000 tcp:8000` et `adb reverse tcp:8081 tcp:8081`.
# Simulateur iOS ou navigateur sur le même ordinateur :
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Émulateur Android : http://10.0.2.2:8000/api/v1
# Téléphone physique en Wi-Fi : http://<adresse-IP-du-PC>:8000/api/v1
# Trouver l’IP actuelle du PC : ip -4 -o addr show scope global

# Clé Google Maps Android, restreinte au package de l’application et à Maps SDK for Android.
GOOGLE_MAPS_API_KEY=
